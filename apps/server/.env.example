# ───── 基础 ─────
NODE_ENV=development
PORT=3000
# 逗号分隔，后台域名
CORS_ORIGINS=http://localhost:5173

# ───── 数据库 / 缓存 ─────
DATABASE_URL=mysql://luoji:luoji_dev_pwd@127.0.0.1:3306/luoji
REDIS_URL=redis://127.0.0.1:6379/0

# ───── 鉴权（生产必须替换为 32 字节以上随机串）─────
JWT_USER_SECRET=change-me-user-secret
JWT_ADMIN_SECRET=change-me-admin-secret
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=30d

# ───── 敏感字段加密：32 字节密钥的 base64（openssl rand -base64 32）─────
DATA_ENCRYPTION_KEY=
DATA_HASH_SALT=change-me-hash-salt

# ───── 微信小程序 ─────
WX_APPID=
WX_SECRET=
# true 时 wx-login 不请求微信，直接用 code 作为 openid（仅限本地开发）
WX_MOCK_LOGIN=true

# ───── 微信支付 V3（客户开通商户号并绑定 AppID 后填写）─────
# true 时支付 / 退款走模拟网关，立即成功（仅限本地开发联调，生产环境开启会拒绝启动）
PAY_MOCK=true
WXPAY_MCHID=
WXPAY_SERIAL_NO=
WXPAY_API_V3_KEY=
WXPAY_PRIVATE_KEY_PATH=
WXPAY_NOTIFY_URL=

# ───── 腾讯云（COS / VOD / SMS）─────
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
COS_REGION=ap-beijing
COS_PRIVATE_BUCKET=
COS_PUBLIC_BUCKET=
VOD_SUB_APP_ID=
VOD_PLAY_KEY=

# ───── 种子数据：初始超级管理员 ─────
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe123!
